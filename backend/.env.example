# Node.js backend
PORT=3000
NODE_ENV=development

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Gemini for chatbot + RAG answer polishing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Python services (default: same machine as Node)
# On a cloud server, point these to localhost ports where Python runs.
LOCAL_AI_BASE_URL=http://127.0.0.1:8000
RAG_SERVICE_URL=http://127.0.0.1:9000

# Production example (all services on one VPS):
# RAG_SERVICE_URL=http://127.0.0.1:9000
# LOCAL_AI_BASE_URL=http://127.0.0.1:8000
